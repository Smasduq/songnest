{
  "name": "web",
  "private": true,
  "version": "0.1.0-alpha.2",
  "description": "Songnest is a music library and player with a pluggable source system.",
  "author": "Smasduq",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smasduq/songnest"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:sidecar": "cargo build --release -p songnest && mkdir -p src-tauri/bin && cp ../target/release/songnest src-tauri/bin/songnest",
    "desktop:build": "npm run desktop:sidecar && tauri build",
    "android:dev": "tauri android dev -f android-backend",
    "android:build": "tauri android build -f android-backend"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
